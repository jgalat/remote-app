{
  "name": "@remote-app/app",
  "version": "0.31.2",
  "description": "A remote torrent manager for Transmission and qBittorrent",
  "main": "expo-router/entry",
  "author": "Jorge Galat <jrgglt@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@11.3.0+sha512.2c403d6594527287672b1f7056343a1f7c3634036a67ffabfcc2b3d7595d843768f8787148d1b57cf7956c90606bbd192857c363af19e96d2d0ec9ec5741d215",
  "repository": {
    "type": "git",
    "url": "https://github.com/jgalat/remote-app"
  },
  "scripts": {
    "dev": "expo start",
    "dev:android": "expo start --android",
    "prebuild": "expo prebuild --clean --platform android",
    "build:android:development": "pnpm dlx --config.ignore-scripts=true eas-cli@19.1.0 build --platform android --local --profile development",
    "build:android:production": "pnpm dlx --config.ignore-scripts=true eas-cli@19.1.0 build --platform android --local --profile production",
    "lint": "eslint --max-warnings=0 .",
    "test:transmission": "pnpm --filter @remote-app/transmission-client test",
    "test:qbittorrent": "pnpm --filter @remote-app/qbittorrent-client test",
    "test:pro": "pnpm --filter @remote-app/pro test",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/dom-webview": "~57.0.1",
    "@expo/metro-runtime": "~57.0.11",
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "^5.9.1",
    "@remote-app/qbittorrent-client": "workspace:*",
    "@remote-app/transmission-client": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~57.0.14",
    "expo-application": "~57.0.2",
    "expo-asset": "~57.0.12",
    "expo-background-task": "~57.0.11",
    "expo-build-properties": "~57.0.12",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.12",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.13",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.4",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-intent-launcher": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-local-authentication": "~57.0.2",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.12",
    "expo-router": "~57.0.14",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-task-manager": "~57.0.11",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.85.0",
    "react-native": "0.86.2",
    "react-native-actions-sheet": "^0.9.8",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-mmkv": "^3.3.3",
    "react-native-pager-view": "8.0.2",
    "react-native-purchases": "^9.15.2",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-tab-view": "^4.3.2",
    "react-native-worklets": "0.10.1",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "@remote-app/pro": "workspace:*"
  },
  "expo": {
    "autolinking": {
      "searchPaths": [
        "./node_modules",
        "./modules",
        "./packages/pro/modules"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.1",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@types/react": "~19.2.18",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "tsdown": "^0.20.3",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
